---
layout: base.njk
pagination:
  data: collections.postsByDay
  size: 1
  alias: group
permalink: "/{{ group.year }}/{{ group.mon }}/{{ group.day }}/"
eleventyComputed:
  title: "{{ group.mon }} {{ group.day }}, {{ group.year }}"
---
{% import "stream.njk" as stream %}
<nav class="crumbs"><a href="/">home</a> · <a href="/{{ group.year }}/">{{ group.year }}</a> · <a href="/{{ group.year }}/{{ group.mon }}/">{{ group.mon }}</a></nav>
<h1>{{ group.mon }} {{ group.day }}, {{ group.year }}</h1>
<ul class="stream">
  {%- for post in group.posts %}{{ stream.item(post, true) }}{% endfor -%}
</ul>
