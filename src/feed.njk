---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.author }} — raw thoughts on AI agents and infra.</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.author }}</name></author>
  {%- if collections.posts | length %}
  <updated>{{ collections.posts[0].date | rfc3339 }}</updated>
  {%- endif %}
  {%- for post in collections.posts %}
  {%- if loop.index0 < 30 %}
  <entry>
    <title>{{ post.data.title or post.data.attribution or "Note" }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date | rfc3339 }}</updated>
    <content type="html"><![CDATA[{{ post.templateContent }}]]></content>
  </entry>
  {%- endif %}
  {%- endfor %}
</feed>
