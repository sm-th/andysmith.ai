{#
  Two header modes. Home ("/" and paginated "/page/N/") gets the rich
  "storefront" masthead with search; every other page (posts, archives) gets the
  minimal reading bar. CTA is "Contacts" → /contacts/. Search redirects to an
  external engine scoped to the site (no local search index).
#}
{%- set mode = "index" if (page.url == "/" or "/page/" in page.url) else "reading" -%}
{%- if mode == "index" -%}
<header class="masthead masthead--index">
  <div class="masthead__brand">
    <a href="/" class="masthead__title">{{ site.title }}</a>
    <p class="masthead__bio">Building scalable self-improving infra for AI agents.</p>
  </div>
  <nav class="masthead__nav">
    <form class="search" role="search" onsubmit="event.preventDefault();var q=this.q.value.trim();if(q){location.href='https://duckduckgo.com/?q=site%3Aandysmith.ai+'+encodeURIComponent(q);}">
      <input type="search" name="q" placeholder="Search…" aria-label="Search this site">
    </form>
    <a class="cta" href="/contacts/">Contacts</a>
  </nav>
</header>
{%- else -%}
<header class="masthead masthead--reading">
  <a href="/" class="masthead__home">{{ site.title }}</a>
  <a class="cta" href="/follow/">Follow</a>
</header>
{%- endif -%}
