<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">

  <meta property="og:type" content="{{ 'article' if isPost else (ogType or 'website') }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  {% if featured_image %}<meta property="og:image" content="{{ site.url }}{{ page.url }}{{ featured_image }}">{% endif %}
  {% if isPost and date %}<meta property="article:published_time" content="{{ date | rfc3339 }}">
  <meta property="article:author" content="{{ site.author }}">{% endif %}

  <meta name="twitter:card" content="{% if featured_image %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  {% if featured_image %}<meta name="twitter:image" content="{{ site.url }}{{ page.url }}{{ featured_image }}">{% endif %}

  <link rel="stylesheet" href="/assets/water.css">
  <link rel="stylesheet" href="/assets/custom.css">

  {%- if isPost %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "url": "{{ site.url }}{{ page.url }}",
    "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
    {% if description %}"description": {{ description | dump | safe }},{% endif %}
    {% if date %}"datePublished": "{{ date | rfc3339 }}",{% endif %}
    {% if featured_image %}"image": "{{ site.url }}{{ page.url }}{{ featured_image }}",{% endif %}
    "author": { "@type": "Person", "name": {{ site.author | dump | safe }} },
    "publisher": { "@type": "Person", "name": {{ site.author | dump | safe }} }
  }
  </script>
  {%- elif page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "url": "{{ site.url }}/",
    "name": {{ site.title | dump | safe }},
    "author": { "@type": "Person", "name": {{ site.author | dump | safe }} }
  }
  </script>
  {%- endif %}

  <script src="/assets/posthog.js"></script>
</head>
<body>
  {% include "header.njk" %}
  <div class="layout">
    <main>{{ content | safe }}</main>
    {% include "sidebar.njk" %}
  </div>
  {% include "nav.njk" %}
  <script src="/assets/time.js" defer></script>
</body>
</html>
