---
layout: base.njk
permalink: /
description: "Andy Smith — building scalable self-improving infra for AI agents."
---
{% import "stream.njk" as stream %}
{% for group in collections.postsByDay %}
<section class="day">
  <h2 class="day__label"><a href="/{{ group.year }}/{{ group.mon }}/{{ group.day }}/">{{ group.posts[0].date | readableDate }}</a></h2>
  <ul class="stream stream--feed">
    {%- for post in group.posts %}{{ stream.item(post, false, false) }}{% endfor -%}
  </ul>
</section>
{% endfor %}
